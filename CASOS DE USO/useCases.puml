@startuml usecases
left to right direction

' --- ATORES ---
actor "Administrador" as Admin
actor "Professor" as Professor
actor "Aluno" as Aluno
actor "Responsável" as Responsavel
actor "Secretaria" as Secretaria

' --- LIMITE DO SISTEMA ---
rectangle "Sistema Espaço Lição de Casa" {

    usecase "Realizar Pagamento" as UC1
    usecase "Acompanhar evolução do aluno" as UC2
    usecase "Agendar aula" as UC3
    usecase "Visualizar agenda de aula" as UC4

    ' --- CADASTROS UNIFICADOS (3 balões) ---
    usecase "Cadastrar Disciplina,\nPlano de aula e Professor" as UCCadAcad
    usecase "Cadastrar Aluno\ne Responsável" as UCCadPessoas
    usecase "Cadastrar Questionário" as UCCadQuest

    usecase "Gerenciar Financeiro" as UC10
    usecase "Gerenciar Dashboard Gerencial" as UC11
    usecase "Responder questionário" as UC12
    usecase "Gerenciar disponibilidade de horário" as UC13

    usecase "Cancelar aula" as UC15
    usecase "Enviar notificação de cancelamento" as UCAuxA
    usecase "Gerar relatório" as UCAuxB
}

' --- RELACIONAMENTOS (ASSOCIAÇÕES) ---
Responsavel --> UC1
Responsavel --> UC2
Responsavel --> UC4

Aluno --> UC1
Aluno --> UC2
Aluno --> UC3
Aluno --> UC4
Aluno --> UC12
Aluno --> UC15

Professor --> UC2
Professor --> UC13
Professor --> UCCadQuest
Professor --> UC15

Secretaria --> UC3
Secretaria --> UCCadPessoas
Secretaria --> UC10
Secretaria --> UC11

Admin --> UC4
Admin --> UCCadAcad
Admin --> UCCadPessoas
Admin --> UCCadQuest
Admin --> UC10
Admin --> UC11
Admin --> UC13

' --- RELACIONAMENTOS ESPECIAIS (INCLUDE / EXTEND) ---
UC15 .down.> UCAuxA : <<include>>
UC10 .down.> UCAuxB : <<extend>>

@enduml